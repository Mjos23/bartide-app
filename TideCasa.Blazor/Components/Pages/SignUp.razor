@page "/signup"
@page "/auth/signup"
@attribute [ExcludeFromInteractiveRouting]
@inherits AuthPageBase

<PageTitle>Make yourself at home. | Tide Casa</PageTitle>
<AuthFrame Title="Make yourself at home." Description="Create your account, then verify your email.">
    @if (NoticeText is not null) { <p role="status">@NoticeText</p> }
    <form method="post" action="/auth/session/signup" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="return_to" value="@ReturnPath" />
        <label class="desk-field" for="email">Email address<input id="email" name="email" type="email" autocomplete="username" maxlength="254" required /></label>
<label class="desk-field" for="password">New password<input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label><p>Use at least 12 characters.</p>
        <button class="bt-one-button" type="submit">Create account</button>
    </form>
    <p>Already have an account? <a href="@AuthLink("/signin")">Sign in</a>.</p><p>Creating an account does not enroll or charge you.</p>
</AuthFrame>
