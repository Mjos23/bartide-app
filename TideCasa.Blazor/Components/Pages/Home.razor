@page "/"
@page "/customer"
@attribute [ExcludeFromInteractiveRouting]
@namespace TideCasa.Blazor.Components.Pages
@using TideCasa.Blazor.Components.Marketing
@inject NavigationManager Navigation

<SeoHead />

@if (CustomerExperience.IsHost(new Uri(Navigation.Uri).Host) || new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/') == "/customer")
{
    <TideCasa.Blazor.Components.Customers.CustomerWelcome />
}
else if (IsBarTide)
{
    <BarTideHome />
}
else
{
    <TideCasaHome />
}

@code {
    private bool IsBarTide
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            return uri.Host.Equals("bar.tide.casa", StringComparison.OrdinalIgnoreCase)
                || uri.AbsolutePath.TrimEnd('/').Equals("/restaurant", StringComparison.OrdinalIgnoreCase);
        }
    }
}
