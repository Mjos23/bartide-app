@page "/purchase/{Plan}"
@inject TideCasaApiClient Api
@inject ServiceBillingClient Billing
@inject IWebHostEnvironment Environment
<PageTitle>Choose your package and pay | Tide Casa</PageTitle>
<div class="bt-unified bt-purchase-process">
    <SiteHeader IsBarTide="@(Plan == "restaurant")" />
    <main class="purchase-main">
        <p class="bt-one-kicker">@(Plan == "restaurant" ? "BARTIDE · BARS & RESTAURANTS" : "TIDE CASA · SMALL BUSINESS APPS")</p><h1>Choose your package.</h1>
        <p class="bt-purchase-intro">Pay securely now. Create your account and tell us about your business afterward.</p>
        @if (Environment.IsDevelopment()) { <p class="purchase-preview-note">Local preview · No payment is collected here.</p> }
        <div class="purchase-grid">
            <section class="purchase-package">
                <h2>Your app starts here.</h2>
                <ol class="bt-purchase-timeline">
                    <li><h3>Choose and pay.</h3><p>Review your total and optional app-store support. Stripe handles your payment securely.</p></li>
                    <li><h3>Set up your account.</h3><p>After payment, use your checkout email to create an account and share your business details.</p></li>
                    <li><h3>Build and review together.</h3><p>Confirmed initial payment starts seven calendar days of private building and review. We work with you to prepare the content and approve your app before launch.</p></li>
                </ol>
                <div class="tide-maintenance-detail"><h3>What the $50/month covers</h3><p>Hosting, basic upkeep and your content editor. Major new features, outside services and store-account fees are separate.</p><p>Maintenance begins with your first payment and renews each month. Cancel before your next renewal; service continues through the paid period.</p></div>
                <p>This package covers your Tide Casa app setup and maintenance. Restaurant customer-payment checkout is currently disabled and is separate from this purchase.</p>
            </section>
            <aside class="purchase-summary" aria-label="Payment details">
                <p class="bt-one-kicker">YOUR BUSINESS APP</p><h2>$600<span>one-time setup</span></h2>
                <p class="tide-monthly-line"><strong>+ $50 / month</strong><br />Hosting and maintenance</p>
                <label class="tide-store-option"><input type="checkbox" @bind="appStores" @bind:after="RefreshQuoteAsync" disabled="@loading" /><span><strong>Add app-store integration · $300 once</strong><small>Packaging and submission support for eligible stores, including Apple and Google. Store approval is separate; developer-account fees are paid by you.</small></span></label>
                @if (quote is not null)
                {
                    <dl class="tide-price-breakdown">
                        <div><dt>App setup</dt><dd>@Usd(quote.SetupCents)</dd></div>
                        @if (quote.AppStoresCents > 0) { <div><dt>App-store package</dt><dd>@Usd(quote.AppStoresCents)</dd></div> }
                        <div><dt>First maintenance month</dt><dd>@Usd(quote.FirstMonthCents)</dd></div>
                        <div class="tide-first-total"><dt>First payment</dt><dd>@Usd(quote.FirstPaymentCents)</dd></div>
                        <div><dt>Then each month</dt><dd>@Usd(quote.MonthlyCents)</dd></div>
                    </dl>
                }
                @if (loading) { <p role="status">Updating your total…</p> }
                @if (error is not null) { <p role="alert">@error</p> }
                <p class="purchase-tax-note">USD. The app-store service is charged once. Monthly maintenance stays $50.</p>
                @if (Notice is not null) { <p class="purchase-preview-note" role="status">@PurchaseNotice</p> }
                @if (Notice is "guest_options_saved" or "checkout_closed")
                {
                    <form method="post" action="/service-billing/purchase/restart" data-enhance="false" class="purchase-payment-form">
                        <AntiforgeryToken /><input type="hidden" name="plan" value="@Plan" /><input type="hidden" name="appStores" value="@appStores.ToString().ToLowerInvariant()" />
                        <label class="purchase-consent"><input type="checkbox" name="confirmed" value="true" required /><span>Close my previous unpaid checkout so I can use these options.</span></label>
                        <button type="submit" class="bt-one-button secondary">Update checkout options</button>
                    </form>
                }
                @if (!string.IsNullOrEmpty(ReferralCode))
                {
                    <p>Your referral pricing needs an account check. You can <a href="@($"/start/{Plan}?appStores={appStores.ToString().ToLowerInvariant()}&referralCode={Uri.EscapeDataString(ReferralCode is { Length: <=32 } ? ReferralCode : "")}")">review your referral offer</a>, or <a href="@($"/purchase/{Plan}?appStores={appStores.ToString().ToLowerInvariant()}")">continue without a referral</a>.</p>
                }
                else if (quote is not null)
                {
                    <form @key="quote.FirstPaymentCents" method="post" action="/service-billing/purchase/guest-checkout" data-enhance="false" class="purchase-payment-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="plan" value="@Plan" /><input type="hidden" name="appStores" value="@appStores.ToString().ToLowerInvariant()" />
                        <input type="hidden" name="termsVersion" value="@options?.TermsVersion" />
                        <label class="purchase-consent"><input type="checkbox" name="acceptedTerms" value="true" required /><span>I agree to pay <strong>@Usd(quote.FirstPaymentCents) now</strong>, then <strong>$50 each month</strong> until I cancel renewal, under the <a href="/service-terms" target="_blank" rel="noopener">service terms</a>.</span></label>
                        <button class="bt-one-button" type="submit" disabled="@(loading || options?.CheckoutAvailable != true || Plan is not ("business" or "restaurant"))">Pay @Usd(quote.FirstPaymentCents) securely</button>
                    </form>
                    <p class="purchase-tax-note">No account needed to pay. Enter your billing email and payment details at Stripe; business setup comes next.</p>
                    @if (options?.CheckoutAvailable != true && !Environment.IsDevelopment()) { <p role="status">Checkout is temporarily unavailable. Please try again shortly or book a demo.</p> }
                }
                <p><a class="bt-one-link" href="/book-a-demo">Book a demo first</a></p>
            </aside>
        </div>
    </main><SiteFooter IsBarTide="@(Plan == "restaurant")" />
</div>
@code {
    [Parameter] public string Plan { get; set; } = "business";
    [SupplyParameterFromQuery(Name="ref")] public string? ReferralCode { get; set; }
    [SupplyParameterFromQuery(Name="appStores")] public bool AppStores { get; set; }
    [SupplyParameterFromQuery(Name="notice")] public string? Notice { get; set; }
    private bool appStores, loading;
    private PackageQuote? quote;
    private string? error;
    private GuestPurchaseOptions? options;
    private string PurchaseNotice => Notice switch { "cancelled" => "You’re back from checkout. Review or resume your package below. A completed purchase will reopen its confirmation.", "confirmation" => "Please review and accept the first payment and monthly renewal.", "guest_options_saved" => "You already opened checkout with different options. Return to those options to resume it, or close the previous unpaid checkout below.", "checkout_closed" => "The previous checkout has expired. Close it below to start with your current options.", "checkout_review" => "Your saved checkout needs a review. Contact hello@tide.casa before trying again.", _ => "We couldn’t confirm checkout. Please retry the same purchase or contact hello@tide.casa; don’t start a separate payment to recover it." };
    protected override async Task OnInitializedAsync()
    {
        appStores = AppStores;
        var result = await Billing.GuestOptionsAsync(CancellationToken.None);
        options = result.Value;
        await RefreshQuoteAsync();
    }
    private async Task RefreshQuoteAsync()
    {
        loading = true; error = null; quote = null;
        try { quote = await Api.GetQuoteAsync(appStores); }
        catch (ApiRequestException ex) { error = ex.Message; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { error = "Your total could not be confirmed. Please try again shortly."; }
        finally { loading = false; }
    }
    private static string Usd(int cents) => (cents / 100m).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}
