@page "/order/{Slug}"
@page "/menu/{Slug}/order"
@inject RestaurantOrderingClient Api
<PageTitle>@(menu?.Name ?? "Your order") | @(IsSampleOrdering ? "Order direct" : "BarTide")</PageTitle>
<div class="bt-unified restaurant-ordering @(IsSampleOrdering ? "sample-ordering" : null)">
    @if (IsSampleOrdering)
    {
        <header class="ordering-nav ordering-venue-nav"><a href="@SectionLink("ordering-menu")">GULF LANTERN<small>BEACH BAR · ST. PETE BEACH</small></a><a class="ordering-builder-link" href="https://bar.tide.casa" target="_blank" rel="noopener">Built by <strong>BarTide</strong></a></header>
    }
    else
    {
        <header class="ordering-nav"><a href="/" aria-label="BarTide home"><img src="/assets/bartide-logo.png" alt="BarTide" width="140" height="47" /></a><span>Good food. Your way.</span></header>
    }
    <main class="ordering-main">
        <nav class="ordering-account-links" aria-label="Customer and staff access" data-enhance-nav="false"><a href="@($"/customer/{Uri.EscapeDataString(Slug)}")">My orders &amp; rewards</a><a href="@($"/access/{Uri.EscapeDataString(Slug)}/staff")">Staff login</a></nav>
        @if (loading)
        {
            <h1>Your menu.</h1><p role="status">Loading the restaurant’s menu…</p>
        }
        else if (menu is null)
        {
            <h1>This menu is unavailable.</h1><p role="alert">@error</p>
            <button class="bt-one-button" type="button" @onclick="LoadMenuAsync">Try again</button>
            @if (!string.IsNullOrEmpty(TableToken)) { <p><a href="@($"/order/{Uri.EscapeDataString(Slug)}")">Open the menu without a table link</a></p> }
        }
        else if (receipt is not null)
        {
            <p class="bt-one-kicker">@menu.Name</p><h1>@(receipt.Status == "awaiting_payment" ? "Finish your payment." : "Your order.")</h1>
            <section class="ordering-panel ordering-receipt" aria-labelledby="receipt-title">
                <h2 id="receipt-title">Order @receipt.Number</h2>
                <p role="status">@ReceiptStatus</p>
                <p>Payment: <strong>@ReceiptPayment</strong>. @if (receipt.Quote.PaymentMethod == "staff") { <span>No payment has been collected through this page.</span> }</p>
                @if (checkout is not null) { <p class="ordering-note">Sandbox payment: use Stripe test card details only. Real card payments are not enabled.</p> }
                @if (checkout?.RefundedCents > 0) { <p>Refunded: @Money(checkout.RefundedCents)</p> }
                @if (checkout?.PendingRefundCents > 0) { <p>Refund in progress: @Money(checkout.PendingRefundCents)</p> }
                <p>@FulfillmentLabel(receipt.Quote.Fulfillment)@(!string.IsNullOrWhiteSpace(receipt.Quote.TableLabel) ? " · " + receipt.Quote.TableLabel : "") · @(receipt.Quote.PaymentMethod == "phone" ? "Pay on my phone" : "Pay staff")</p>
                <ul class="ordering-summary-lines">@foreach (var line in receipt.Quote.Lines) { <li><span>@line.Quantity × @line.Name<OrderLineChoices Line="line" /></span><strong>@Money(line.UnitCents * line.Quantity)</strong></li> }</ul>
                <dl class="ordering-totals">
                    <div><dt>Food and drinks</dt><dd>@Money(receipt.Quote.SubtotalCents)</dd></div>
                    <div><dt>Tax</dt><dd>@Money(receipt.Quote.TaxCents)</dd></div>
                    @if (receipt.Quote.DeliveryFeeCents > 0) { <div><dt>Delivery</dt><dd>@Money(receipt.Quote.DeliveryFeeCents)</dd></div> }
                    <div><dt>Tip</dt><dd>@Money(receipt.Quote.TipCents)</dd></div>
                    <div class="ordering-total"><dt>Total to pay</dt><dd>@Money(receipt.Quote.TotalCents)</dd></div>
                </dl>
                @if (receipt.Delivery is { } delivery)
                {
                    <section aria-label="Delivery updates" class="delivery-progress">
                        <h3>Your delivery</h3>
                        @if (!string.IsNullOrWhiteSpace(menu.Checkout.ContactPhone)) { <p><a href="@("tel:" + Uri.EscapeDataString(menu.Checkout.ContactPhone))">Contact @menu.Name · @menu.Checkout.ContactPhone</a></p> }
                        else if (IsSampleOrdering) { <p>Fictional delivery rehearsal · <a href="/sample-bar#perspectives">Open the manager view for restaurant help</a></p> }
                        <ul class="delivery-timeline">
                            <li class="@(receipt.Status is "accepted" or "preparing" or "ready" or "out_for_delivery" or "delivered" or "completed" ? "done" : null)">Restaurant acceptance</li>
                            <li class="@(delivery.AssignedAt is not null ? "done" : null)">Driver assigned</li>
                            <li class="@(delivery.AcknowledgedAt is not null ? "done" : null)">Driver acknowledged</li>
                            <li class="@(delivery.CollectedAt is not null ? "done" : null)">On the way</li>
                            <li class="@(delivery.DeliveredAt is not null ? "done" : null)">Delivered</li>
                        </ul>
                        @if (delivery.DriverName is not null) { <p>Your driver: <strong>@delivery.DriverName</strong></p> }
                        @if (delivery.ProblemCode is not null) { <p role="status">The restaurant is resolving a delivery issue. Please contact the restaurant with your order number.</p> }
                        <p class="ordering-note">Last change: @DateTimeOffset.Parse(delivery.UpdatedAt).ToString("MMM d, h:mm tt 'UTC'"). @(ShouldPollDelivery ? "Updates automatically while this page is open." : "Delivery updates finished.")</p>
                        @if (deliveryCheckedAt is { } checkedAt) { <small>Last checked @checkedAt.ToString("h:mm:ss tt 'UTC'")</small> }
                        @if (deliveryRefreshError is not null) { <p role="alert" class="ordering-error">@deliveryRefreshError</p> }
                    </section>
                }
                @if (receipt.Status == "out_for_delivery") { <DeliveryLocationPanel Location="@deliveryLocation" /> }
                <p>Keep this private receipt and your order number for help from the restaurant.</p>
                <p><a href="@($"/customer/{Uri.EscapeDataString(Slug)}")" data-enhance-nav="false">My orders &amp; rewards →</a> <span>@(savedToAccount ? "Saved to your account." : "Sign in to save this receipt and return to it later.")</span></p>
                @if (receipt.Delivery is null) { <p class="ordering-note" role="status">@CustomerOrderStatus.Label(receipt.Status) @if (!CustomerOrderStatus.Finished(receipt.Status)) { <span>· Status updates automatically while this page is open.</span> } @deliveryRefreshError</p> }
                <button class="ordering-secondary" type="button" @onclick="RefreshReceiptAsync" disabled="@busy">@(busy ? "Checking…" : "Check order status")</button>
                @if (checkout?.State == "open")
                {
                    @if (checkout.CheckoutUrl is not null) { <button class="bt-one-button" type="button" @onclick="ResumePayment" disabled="@busy">Continue to card payment</button> }
                    <button class="ordering-secondary" type="button" @onclick="CancelPaymentAsync" disabled="@busy">Cancel unpaid checkout</button>
                }
                <button class="ordering-secondary" type="button" @onclick="StartAnotherOrderAsync" disabled="@(busy || checkout?.State is "reserved" or "creating" or "open" or "review")">Start another order</button>
                @if (error is not null) { <p class="ordering-error" role="alert">@error</p> }
            </section>
        }
        else
        {
            @if (IsSampleOrdering)
            {
                <SampleRestaurantWelcome RestaurantName="@menu.Name" />
            }
            else
            {
                <p class="bt-one-kicker">ORDER FROM YOUR TABLE OR ON THE GO</p><h1>@menu.Name</h1>
                <nav class="rm-workspace-nav" aria-label="Restaurant"><a href="@($"/rewards/{Uri.EscapeDataString(Slug)}")">Customer rewards</a><a href="@($"/events/{Uri.EscapeDataString(Slug)}")">Events and RSVP</a><a href="@($"/updates/{Uri.EscapeDataString(Slug)}")">Latest updates · Phone alerts</a></nav>
            }
            @if (!connected) { <p class="ordering-note" role="status">Connecting to the restaurant…</p> }
            @if (menu.Table is not null) { <p class="ordering-table-badge">You scanned @menu.Table.Label.</p> }
            @if (!menu.Checkout.AcceptingOrders) { <p class="ordering-notice" role="status">The restaurant is not accepting new online orders right now. You can still browse the menu.</p> }
            <nav class="ordering-category-links" aria-label="Jump to menu section">
                <span>Explore</span>
                @foreach (var category in MenuGroups)
                {
                    <a href="@SectionLink("category-" + category.Key)" @onclick="() => JumpCategoryAsync(category.Key)" @onclick:preventDefault="true">@CategoryJumpLabel(category.Key)</a>
                }
                <a href="@($"/events/{Uri.EscapeDataString(Slug)}")">Events</a>
            </nav>
            <div class="ordering-layout">
                <section id="ordering-menu" aria-label="Menu" class="ordering-menu" tabindex="-1">
                    @foreach (var category in MenuGroups)
                    {
                        <section class="ordering-category" aria-labelledby="@("category-" + category.Key)">
                            <h2 id="@("category-" + category.Key)" tabindex="-1">@CategoryName(category.Key)</h2>
                            @foreach (var item in category)
                            {
                                <article class="ordering-menu-item" id="@("item-" + item.Id)">
                                    <div class="ordering-item-content">
                                    <div class="ordering-item-media @(item.PhotoId is not null ? "has-photo" : null)">
                                    @if (item.PhotoId is not null) { <button class="ordering-photo-button" type="button" aria-label="@($"View {item.Name} details and options")" @onclick="() => OpenItem(item)" disabled="@(!connected)"><img class="ordering-item-photo" src="@($"/media/{Uri.EscapeDataString(item.PhotoId)}")" alt="@item.Name" loading="lazy" width="640" height="480" /></button> }
                                    @if (item.Available && item.PriceCents is >= 0)
                                    {
                                        <div class="ordering-quantity" aria-label="@($"Quantity of {item.Name}")">
                                            <button type="button" class="ordering-secondary" aria-label="@($"Remove one {item.Name}")" disabled="@(Locked || Quantity(item.Id) == 0)" @onclick="() => ChangeQuantityAsync(item.Id, -1)">−</button>
                                            <output aria-live="polite">@Quantity(item.Id)</output>
                                            <button type="button" class="ordering-secondary" aria-label="@($"Add one {item.Name}")" disabled="@(Locked || Quantity(item.Id) >= 20 || cart.Values.Sum() >= 50 || (Quantity(item.Id) == 0 && cart.Count >= 20))" @onclick="() => ChangeQuantityAsync(item.Id, 1)">+</button>
                                        </div>
                                    }
                                    </div>
                                    <h3>@item.Name</h3><p>@item.Description</p><strong>@(item.PriceCents is { } price ? Money(price) : item.PriceLabel ?? "Ask staff")</strong>
                                    <button type="button" class="ordering-details-link" @onclick="() => OpenItem(item)" disabled="@(!connected)">Details &amp; options</button>
                                    @if (customizations.TryGetValue(item.Id, out var itemChoices))
                                    {
                                        @if (itemChoices.RemovedIngredients is { Count: > 0 }) { <p class="ordering-note">No @string.Join(", ", itemChoices.RemovedIngredients)</p> }
                                        @if (itemChoices.SpecialRequest is not null) { <p class="ordering-note">Request: @itemChoices.SpecialRequest</p> }
                                    }
                                    @if (!item.Available) { <p class="ordering-note">Currently unavailable</p> }
                                    </div>
                                </article>
                            }
                        </section>
                    }
                    @if (menu.Items.Count == 0) { <p>No menu items are available right now.</p> }
                </section>
                <aside id="ordering-checkout" class="ordering-panel ordering-checkout" aria-labelledby="your-order-title" tabindex="-1">
                    <h2 id="your-order-title">Your order</h2>
                    <a class="ordering-back-menu" href="@SectionLink("ordering-menu")">Continue browsing ↑</a>
                    @if (CartItemCount > 0)
                    {
                        <p class="ordering-cart-preview" role="status">@CartItemCount @(CartItemCount == 1 ? "item" : "items") · @Money(CartAmountCents) @CartAmountLabel.ToLowerInvariant()</p>
                    }
                    <fieldset class="ordering-options" disabled="@Locked"><legend>How would you like your order?</legend>
                        <label><input type="radio" name="fulfillment" value="dine-in" checked="@(fulfillment == "dine-in")" @onchange='() => SetFulfillmentAsync("dine-in")' disabled="@(!menu.Checkout.DineInEnabled)" /><span>Dine in @if (menu.Table is not null) { <small>@menu.Table.Label</small> }</span></label>
                        <label><input type="radio" name="fulfillment" value="pickup" checked="@(fulfillment == "pickup")" @onchange='() => SetFulfillmentAsync("pickup")' disabled="@(!menu.Checkout.PickupEnabled)" /><span>Pickup</span></label>
                        <label><input type="radio" name="fulfillment" value="delivery" checked="@(fulfillment == "delivery")" @onchange='() => SetFulfillmentAsync("delivery")' disabled="@(!menu.Checkout.DeliveryEnabled)" /><span>Delivery</span></label>
                    </fieldset>
                    @if (fulfillment == "dine-in" && menu.Table is null)
                    {
                        <label class="desk-field">Table number or name<input type="text" value="@tableLabel" @onchange="SetTableLabelAsync" maxlength="40" autocomplete="off" placeholder="e.g. 4 or Patio 1" disabled="@Locked" required /></label>
                        <p class="ordering-note">Use the number or name shown at your table, or scan its QR code.</p>
                    }
                    @if (fulfillment == "pickup" && !string.IsNullOrWhiteSpace(menu.Checkout.PickupInstructions)) { <p>@menu.Checkout.PickupInstructions</p> }
                    @if (fulfillment == "delivery")
                    {
                        <label class="desk-field">Delivery ZIP code<input type="text" inputmode="numeric" autocomplete="postal-code" maxlength="5" value="@deliveryZip" @onchange="SetZipAsync" disabled="@Locked" /></label>
                        <p class="ordering-note">Delivery minimum: @Money(menu.Checkout.DeliveryMinimumCents) before tax, delivery and tip. Delivery fee: @Money(menu.Checkout.DeliveryFeeCents).</p>
                    }
                    <fieldset class="ordering-options" disabled="@Locked"><legend>How would you like to pay?</legend>
                        <label><input type="radio" name="payment" value="staff" checked="@(payment == "staff")" @onchange='() => SetPaymentAsync("staff")' disabled="@(!menu.Checkout.PayStaffEnabled)" /><span>Pay staff<small>Pay the restaurant directly.</small></span></label>
                        <label><input type="radio" name="payment" value="phone" checked="@(payment == "phone")" @onchange='() => SetPaymentAsync("phone")' disabled="@(!menu.Checkout.PhonePaymentAvailable)" /><span>Pay on my phone<small>@(menu.Checkout.PhonePaymentAvailable ? "Secure card checkout · sandbox" : "Not available yet.")</small></span></label>
                    </fieldset>
                    @if (payment == "phone") { <p class="ordering-notice" role="status">@(menu.Checkout.PhonePaymentAvailable ? "You will continue to Stripe's sandbox to pay by card. Use test card details only; real payments are not enabled." : "Phone payments are being prepared. Choose Pay staff if available to send an unpaid order to the restaurant.")</p> }
                    @if (!string.IsNullOrWhiteSpace(menu.Checkout.PaymentInstructions)) { <p class="ordering-note">@menu.Checkout.PaymentInstructions</p> }
                    @if (menu.Checkout.TipsEnabled)
                    {
                        <fieldset class="ordering-options ordering-tips" disabled="@Locked"><legend>Add an optional tip</legend>
                            @foreach (var choice in TipChoices)
                            {
                                <label><input type="radio" name="tip" value="@choice.Value" checked="@(tipChoice == choice.Value)" @onchange="() => SetTipAsync(choice.Value)" /><span>@choice.Label</span></label>
                            }
                        </fieldset>
                        @if (tipChoice == "custom") { <label class="desk-field">Custom tip (USD)<input type="text" inputmode="decimal" value="@customTip" maxlength="8" placeholder="0.00" @onchange="SetCustomTipAsync" disabled="@Locked" /></label> }
                        <p class="ordering-note">Tips are optional. Percentages apply to food and drinks before tax and delivery. Custom tips cannot exceed that subtotal or $500.</p>
                    }
                    @if (cart.Count == 0) { <p>Add something from the menu to get started.</p> }
                    @if (quoting) { <p role="status">Checking availability and your total…</p> }
                    @if (quote is not null)
                    {
                        @if (quote.TableLabel is not null) { <p class="ordering-note">Deliver to: <strong>@quote.TableLabel</strong></p> }
                        <ul class="ordering-summary-lines">@foreach (var line in quote.Lines) { <li><span>@line.Quantity × @line.Name<OrderLineChoices Line="line" /></span><strong>@Money(line.UnitCents * line.Quantity)</strong></li> }</ul>
                        <dl class="ordering-totals">
                            <div><dt>Food and drinks</dt><dd>@Money(quote.SubtotalCents)</dd></div><div><dt>Tax</dt><dd>@Money(quote.TaxCents)</dd></div>
                            @if (quote.DeliveryFeeCents > 0) { <div><dt>Delivery</dt><dd>@Money(quote.DeliveryFeeCents)</dd></div> }
                            <div><dt>Tip</dt><dd>@Money(quote.TipCents)</dd></div><div class="ordering-total"><dt>Total to pay</dt><dd>@Money(quote.TotalCents)</dd></div>
                        </dl>
                        @if (!quote.CanSubmit && payment != "phone") { <p class="ordering-notice">The restaurant cannot accept this selection right now. Check its available ordering and payment options.</p> }
                    }
                    @if (error is not null) { <p class="ordering-error" role="alert">@error</p> }
                    @if (cart.Count > 0 && quote is null && !quoting && !Locked) { <button class="ordering-secondary" type="button" @onclick="RefreshQuoteAsync">Check total again</button> }
                    @if (uncertain)
                    {
                        <div class="ordering-notice"><h3>Let’s confirm your order.</h3><p>Keep this page open. Your choices are saved here. Retrying sends the same order request so it cannot create a duplicate.</p></div>
                        <button class="bt-one-button" type="button" @onclick="SubmitAsync" disabled="@busy">@(busy ? "Confirming…" : "Retry this order")</button>
                    }
                    else
                    {
                        <form @onsubmit="ReviewAsync" @onsubmit:preventDefault="true">
                            <fieldset class="ordering-fields" disabled="@(Locked || reviewing)">
                                <label class="desk-field">Your name<input type="text" @bind="customerName" @bind:event="oninput" maxlength="80" autocomplete="name" required /></label>
                                <label class="desk-field">Phone number@(fulfillment == "dine-in" ? " (optional)" : "")<input type="tel" @bind="phone" @bind:event="oninput" maxlength="30" autocomplete="tel" required="@(fulfillment != "dine-in")" /></label>
                                @if (fulfillment == "delivery") { <label class="desk-field">Delivery address<input type="text" @bind="address" @bind:event="oninput" maxlength="250" autocomplete="street-address" required /></label> }
                                <label class="desk-field">Special requests for your order (optional)<textarea @bind="note" @bind:event="oninput" rows="3" maxlength="500" placeholder="It’s Grandma’s birthday, or please make it extra crispy…" /></label>
                                <p class="ordering-note">We’ll pass your requests to the restaurant. For allergies, please also speak to staff.</p>
                                @if (!reviewing) { <button class="bt-one-button" type="submit" disabled="@(!CanReview)">Review order</button> }
                            </fieldset>
                        </form>
                        @if (reviewing && quote is not null)
                        {
                            <div class="ordering-review" role="status"><h3>Ready to send?</h3><p>@FulfillmentLabel(quote.Fulfillment)@(!string.IsNullOrWhiteSpace(quote.TableLabel) ? " · " + quote.TableLabel : "") · @(payment == "phone" ? "Pay on my phone" : "Pay staff")</p><p>@customerName @if (!string.IsNullOrWhiteSpace(phone)) { <span>· @phone</span> }</p>@if (fulfillment == "delivery") { <p>@address @deliveryZip</p> }<p>Total to pay: <strong>@Money(quote.TotalCents)</strong>, including @Money(quote.TipCents) tip.</p><p>@(payment == "phone" ? "This reserves your order while you complete card payment. The restaurant can accept it after payment is confirmed." : "This sends an unpaid order request. The restaurant must accept it before preparing your order.")</p></div>
                            <button class="ordering-secondary" type="button" disabled="@busy" @onclick="EditDetails">Edit details</button>
                            <button class="bt-one-button" type="button" disabled="@(busy || !CanReview)" @onclick="SubmitAsync">@(busy ? "Confirming your order..." : payment == "phone" ? "Continue to card payment" : "Send order · Pay staff")</button>
                        }
                    }
                </aside>
            </div>
                <nav class="ordering-cart-bar" aria-label="Your cart">
                    <div role="status" aria-live="polite" aria-atomic="true">
                        <strong>@CartItemCount @(CartItemCount == 1 ? "item" : "items") · @Money(CartAmountCents)</strong>
                        <small>@(CartItemCount == 0 ? "Add your favorites from the menu" : quoting ? "Checking total…" : quote is null ? "Items subtotal · confirm at checkout" : "Total including tax and tip")</small>
                    </div>
                    <a class="bt-one-button" href="@SectionLink("ordering-checkout")" @onclick="GoToCheckoutAsync" @onclick:preventDefault="true">View cart &amp; checkout</a>
                </nav>
        }
            @if (detailItem is { } selectedItem)
            {
                <dialog id="ordering-item-dialog" class="ordering-item-dialog" aria-labelledby="ordering-item-title" @onkeydown="ItemKeyAsync">
                    <div class="ordering-dialog-heading"><span>Make it yours</span><button type="button" class="ordering-secondary" @onclick="CloseItemAsync" autofocus aria-label="Close item details">Close ×</button></div>
                    @if (selectedItem.PhotoId is not null) { <img class="ordering-detail-photo" src="@($"/media/{Uri.EscapeDataString(selectedItem.PhotoId)}")" alt="@selectedItem.Name" width="640" height="480" /> }
                    <h2 id="ordering-item-title">@selectedItem.Name</h2>
                    <p>@selectedItem.Description</p>
                    <strong>@(selectedItem.PriceCents is { } selectedPrice ? Money(selectedPrice) : selectedItem.PriceLabel ?? "Ask staff")</strong>
                    @if (selectedItem.Ingredients is { Count: > 0 })
                    {
                        <fieldset class="ordering-ingredient-options" disabled="@(Locked || !selectedItem.Available || selectedItem.PriceCents is null)">
                            <legend>Ingredients</legend><p>Included as listed. Check anything you’d like left off.</p>
                            @foreach (var ingredient in selectedItem.Ingredients)
                            {
                                <label><span>@ingredient</span><span><input type="checkbox" checked="@draftRemoved.Contains(ingredient)" @onchange="args => ToggleIngredient(ingredient, args)" /> Leave off</span></label>
                            }
                        </fieldset>
                    }
                    else { <p class="ordering-note">Ask the restaurant about ingredients, or add a request below.</p> }
                    <label class="desk-field">Request for this item (optional)<textarea @bind="draftRequest" @bind:event="oninput" rows="3" maxlength="240" placeholder="For example, extra extra crispy or sauce on the side" disabled="@Locked" /></label>
                    <p class="ordering-note">These choices apply to every serving of this item in your cart. Requests depend on what the kitchen can do; the price stays the same. For allergies, please speak to staff.</p>
                    @if (detailError is not null) { <p class="ordering-error" role="alert">@detailError</p> }
                    <div class="ordering-dialog-actions">
                        <div class="ordering-quantity" aria-label="Item quantity"><button type="button" class="ordering-secondary" aria-label="Reduce item quantity" disabled="@(Locked || draftQuantity <= 1)" @onclick="() => draftQuantity--">−</button><output aria-live="polite">@draftQuantity</output><button type="button" class="ordering-secondary" aria-label="Increase item quantity" disabled="@(Locked || draftQuantity >= DetailMaximum)" @onclick="() => draftQuantity++">+</button></div>
                        <button type="button" class="bt-one-button" disabled="@(!CanSaveItem)" @onclick="SaveItemChoiceAsync">@(Quantity(selectedItem.Id) > 0 ? "Update cart" : "Add to cart") @if (selectedItem.PriceCents is { } linePrice) { <span>· @Money(linePrice * draftQuantity)</span> }</button>
                    </div>
                    @if (!selectedItem.Available || selectedItem.PriceCents is null) { <p class="ordering-note">This item cannot be ordered online right now.</p> }
                    else if (!CanSaveItem && !Locked) { <p class="ordering-note">Your cart can hold up to 20 different items and 50 servings. Adjust the cart to add this item.</p> }
                </dialog>
            }
    </main>
    <footer class="ordering-footer">
        @if (IsSampleOrdering)
        {
            <nav class="sample-customer-links" aria-label="More from Gulf Lantern"><a href="/rewards/gulf-lantern">Customer rewards</a><a href="/events/gulf-lantern">Events &amp; RSVP</a><a href="/updates/gulf-lantern">Latest updates</a></nav>
            <span>Gulf Lantern’s own restaurant app · Powered by Tide Casa</span>
        }
        else { <span>Powered by BarTide</span> }
    </footer>
</div>
