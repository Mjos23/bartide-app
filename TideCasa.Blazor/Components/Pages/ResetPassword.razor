@page "/reset-password"
@page "/auth/reset-password"
@attribute [ExcludeFromInteractiveRouting]
@inherits AuthPageBase

<PageTitle>Choose a new password. | Tide Casa</PageTitle>
<AuthFrame Title="Choose a new password." Description="Use the reset code from your email.">
    @if (NoticeText is not null) { <p role="status">@NoticeText</p> }
    <form method="post" action="/auth/session/reset" data-enhance="false" data-confirm-password>
        <AntiforgeryToken />
        <input type="hidden" name="return_to" value="@ReturnPath" />
        <label class="desk-field" for="email">Email address<input id="email" name="email" type="email" autocomplete="username" maxlength="254" required /></label>
        <label class="desk-field" for="code">Password reset code<input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}" minlength="6" maxlength="10" required /></label>
        <label class="desk-field" for="password">New password<input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
        <p>Use at least 12 characters.</p>
        <label class="desk-field" for="confirm-password">Confirm new password<input id="confirm-password" name="confirm_password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
        <button class="bt-one-button" type="submit">Update password</button>
    </form>
    <p><a href="@AuthLink("/forgot-password")">Request a new reset code</a></p><p><a href="@AuthLink("/signin")">Return to sign in</a></p>
</AuthFrame>
