@page "/forgot-password"
@page "/auth/forgot-password"
@attribute [ExcludeFromInteractiveRouting]
@inherits AuthPageBase

<PageTitle>Let’s get you back in. | Tide Casa</PageTitle>
<AuthFrame Title="Let’s get you back in." Description="Request a password reset code by email.">
    @if (NoticeText is not null) { <p role="status">@NoticeText</p> }
    <form method="post" action="/auth/session/forgot" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="return_to" value="@ReturnPath" />
        <label class="desk-field" for="email">Email address<input id="email" name="email" type="email" autocomplete="username" maxlength="254" required /></label>
        <button class="bt-one-button" type="submit">Send reset code</button>
    </form>
    <p><a href="@AuthLink("/reset-password")">Already have a reset code?</a></p><p><a href="@AuthLink("/signin")">Return to sign in</a></p>
</AuthFrame>
