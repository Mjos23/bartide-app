@inject OrderingRequestContext OrderingContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="/tide-casa/favicon.svg" />
    <link rel="manifest" href="@ManifestHref" />
    <link rel="apple-touch-icon" sizes="180x180" href="@(IsBarHost ? "/app-icons/icon-180.png" : "/tide-casa/app-icons/icon-180.png")" />
    <meta name="theme-color" content="#123b48" />
    <link rel="stylesheet" href="/brand.css" />
    <link rel="stylesheet" href="/verticals.css" />
    <link rel="stylesheet" href="/workspace.css" />
    <link rel="stylesheet" href="/loyalty.css" />
    <link rel="stylesheet" href="/bartide-one.css" />
    <link rel="stylesheet" href="/tide-casa/homepage.css?v=payment-first-20260921" />
    <link rel="stylesheet" href="/bartide-night.css" />
    <link rel="stylesheet" href="/bartide-pitch.css?v=20260924" />
    <link rel="stylesheet" href="/install.css" />
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/restaurant-management.css" />
    <link rel="stylesheet" href="/delivery-location.css?v=20260924" />
    <link rel="stylesheet" href="/driver-delivery.css?v=20260924" />
    <link rel="stylesheet" href="/TideCasa.Blazor.styles.css?v=20260924" />
    <link rel="stylesheet" href="/media.css" />
    <link rel="stylesheet" href="/rewards.css" />
    <link rel="stylesheet" href="/service-billing.css" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <TideCasa.Blazor.Components.Marketing.InstallControl IsBarTide="@IsBarHost" />
    <Routes ProtectedOrderingContext="@protectedOrderingContext" @rendermode="PageRenderMode" />
    <script src="/app.js"></script>
    <script src="/delivery-location.js?v=20260924"></script>
    <script src="/delivery-status.js?v=20260924"></script>
    <script src="/merchant-payments.js"></script>
    <script src="/business-posts.js"></script>
    <script src="/email-tracking.js?v=20260923"></script>
    <script src="/bartide-savings.js?v=20260924"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
    private string? protectedOrderingContext;
    private bool IsBarHost => HttpContext.Request.Host.Host.Equals("bar.tide.casa", StringComparison.OrdinalIgnoreCase);
    private string ManifestHref
    {
        get
        {
            var restaurant = System.Text.RegularExpressions.Regex.Match(HttpContext.Request.Path.Value ?? "", "^/bar/([a-z0-9-]{1,200})/?$", System.Text.RegularExpressions.RegexOptions.CultureInvariant);
            if (restaurant.Success) return "/bar/" + Uri.EscapeDataString(restaurant.Groups[1].Value) + "/manifest.webmanifest";
            var updates = System.Text.RegularExpressions.Regex.Match(HttpContext.Request.Path.Value ?? "", "^/updates/([A-Za-z0-9_-]{1,128})/?$", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);
            return updates.Success ? TideCasa.Blazor.Features.BusinessPosts.BusinessPostsFlow.Manifest(updates.Groups[1].Value)
                : IsBarHost ? "/bartide.webmanifest" : "/tide-casa.webmanifest";
        }
    }
    protected override void OnInitialized() => protectedOrderingContext = OrderingContext.ProtectForCircuit();
}
