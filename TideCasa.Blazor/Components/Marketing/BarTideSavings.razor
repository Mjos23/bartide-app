@namespace TideCasa.Blazor.Components.Marketing
@inject NavigationManager Navigation

<div class="pitch-comparison" data-bartide-savings>
    <fieldset class="pitch-assumptions">
        <legend>Make the numbers yours</legend>
        <label for="pitch-sales">Monthly sales you could move from DoorDash
            <span class="pitch-money-input"><span aria-hidden="true">$</span><input id="pitch-sales" data-savings-sales type="number" value="20000" min="0" max="1000000" step="any" inputmode="decimal" aria-describedby="pitch-math-note pitch-input-error" /></span>
        </label>
        <label for="pitch-rate">Your DoorDash delivery commission
            <select id="pitch-rate" data-savings-rate aria-describedby="pitch-math-note"><option value="15">15% · Basic</option><option value="25">25% · Plus</option><option value="30" selected>30% · Premier</option></select>
        </label>
    </fieldset>
    <p class="pitch-input-error" id="pitch-input-error" data-savings-error hidden>Enter monthly sales between $0 and $1,000,000.</p>
    <div class="pitch-numbers" aria-label="Illustrative monthly cost comparison" aria-live="polite" aria-atomic="true">
        <div class="pitch-number"><span class="pitch-number-label">DoorDash commission</span><strong data-savings-commission>$6,000</strong><span>per month on those sales</span></div>
        <div class="pitch-number"><span class="pitch-number-label">BarTide monthly plan</span><strong>$149</strong><span>per month, starting after 30 days</span></div>
        <div class="pitch-number pitch-number-saving" data-savings-panel><span class="pitch-number-label" data-savings-label>Potential monthly savings*</span><strong data-savings-difference>$5,851</strong><span data-savings-caption>you could keep, before other costs</span></div>
    </div>
    <div class="pitch-actions"><a class="pitch-button" href="/purchase/restaurant">Purchase your app <span aria-hidden="true">↗</span></a><a class="pitch-button pitch-button-outline" href="/book-a-demo">Book a demo</a></div>
    <p class="pitch-price-note"><strong>$600 initial purchase.</strong> 30-day build &amp; review. Then $149/month, starting 30 days after purchase.</p>
    <p class="pitch-math-note" id="pitch-math-note">*Illustrative example, not an industry average or guaranteed savings. Excludes $600 setup, payment processing, delivery and other outside costs. BarTide does not supply drivers or marketplace customers.</p>
    <p class="pitch-availability"><span aria-hidden="true">◌</span> Your preferred payment integration, agreed together during setup. <a href="@(new Uri(Navigation.Uri).PathAndQuery + "#included")">Explore what's included.</a></p>
    <details class="pitch-calculation-details">
        <summary>How we calculate the comparison</summary>
        <p>Monthly sales you could move × your selected DoorDash commission rate − $149 BarTide monthly fee, rounded to the nearest dollar. The default example is $20,000 × 30% − $149 = $5,851. A negative result means BarTide's monthly fee is higher than the illustrated commission. The $600 initial purchase is separate; no monthly BarTide fee is due for the first 30 days.</p>
        <p>These are DoorDash's published US Marketplace delivery rates, checked September 24, 2026. Pickup and other DoorDash products have different pricing; your contract may differ. This is a comparison of fees, not equivalent services or a projection of sales. <a href="https://merchants.doordash.com/en-us/pricing" target="_blank" rel="noopener noreferrer">See DoorDash's current pricing ↗</a></p>
    </details>
    <noscript><p class="pitch-math-note">Enable JavaScript to change the comparison. The example above uses $20,000 in monthly sales at a 30% commission rate.</p></noscript>
</div>
