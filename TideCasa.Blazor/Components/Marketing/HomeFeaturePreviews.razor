@namespace TideCasa.Blazor.Components.Marketing

<section class="bt-one-section bt-feature-section bt-silk" id="included">
    <p class="bt-feature-eyebrow">What’s included</p>
    <div class="bt-one-heading"><h2>A <em>smoother</em> day.</h2><p>More reasons to return.<br /><span class="bt-feature-caption">Illustrative views of your restaurant’s tools.</span></p></div>
    <div class="bt-feature-grid">
        <article class="bt-feature-card">
            <div class="bt-feature-copy"><h3>Customer rewards, your way.</h3><p>Buy nine, get the tenth free. A treat for a monthly visit goal. You choose the item, visit goal and reward that keep your guests coming back.</p></div>
            <div class="bt-feature-visual bt-reward-preview"><div class="bt-preview-top"><span><MarketingIcon Name="heart" Size="17" Class="bt-loyalty-heart" /> GUEST REWARDS</span><span>Your chosen reward</span></div><div class="bt-reward-balance"><strong>9</strong><span>coffees collected</span></div><p class="bt-reward-note">Your tenth coffee is a gift.</p></div>
        </article>
        <article class="bt-feature-card">
            <div class="bt-feature-copy"><h3>A menu that looks like you.</h3><p>Your photos, dishes, and specials. Easy to browse. Easy to keep fresh.</p></div>
            <div class="bt-feature-visual bt-menu-preview"><img src="/demo/assets/menu/gulf-tacos.webp" alt="Fish tacos with fresh slaw and lime" width="320" height="213" loading="lazy" /><div><span class="bt-preview-label">ON THE MENU</span><strong>Gulf fish tacos</strong><p>Fresh catch. Citrus slaw.<br />A little coastal flavor.</p></div></div>
        </article>
        <article class="bt-feature-card">
            <div class="bt-feature-copy"><h3>Orders, delivery and payments.</h3><p>Pickup and your own delivery team, together with card checkout. Your guests pay your restaurant through its own connected Stripe account.</p></div>
            <div class="bt-feature-visual bt-order-preview"><div class="bt-preview-top"><span>ORDER #104</span><span>Pickup</span></div><strong>2 × Gulf fish tacos</strong><div class="bt-order-stages"><span><MarketingIcon Name="check" Size="15" /> Received</span><span class="current">Preparing</span><span>Ready</span></div><p><MarketingIcon Name="truck" Size="17" /> Your team handles delivery.</p></div>
        </article>
        <article class="bt-feature-card">
            <div class="bt-feature-copy"><h3>A little more care for your team.</h3><p>Employee schedules, private messages and rewards you choose. Keep your next shift connected and recognize the people behind it.</p></div>
            <div class="bt-feature-visual bt-shift-preview"><div class="bt-preview-top"><span><MarketingIcon Name="calendar-days" Size="17" /> FRIDAY’S TEAM</span></div><div class="bt-shift-row"><strong>Mia <small>Kitchen</small></strong><span>11 am – 7 pm</span></div><div class="bt-shift-row"><strong>Chris <small>Delivery</small></strong><span>4 pm – 10 pm</span></div><p><MarketingIcon Name="message-circle" Size="17" /> Messages, shifts and recognition.</p></div>
        </article>
        <article class="bt-feature-card">
            <div class="bt-feature-copy"><h3>A thoughtful first day.</h3><p>Employee onboarding video courses, ready when your new hires are. Share your welcome, workplace guidance and training in one place.</p></div>
            <div class="bt-feature-visual bt-shift-preview"><div class="bt-preview-top"><span><MarketingIcon Name="book-open" Size="17" /> TEAM ONBOARDING</span></div><div class="bt-shift-row"><strong>Your first shift</strong><span>Video course</span></div><div class="bt-shift-row"><strong>Getting to know the menu</strong><span>Video course</span></div><p>Learn at your own pace.</p></div>
        </article>
        <article class="bt-feature-card">
            <div class="bt-feature-copy"><h3>Live events. Familiar faces.</h3><p>Give guests a date to look forward to. Share your live events and details, with RSVPs to keep your guest responses together.</p></div>
            <div class="bt-feature-visual bt-share-preview"><div class="bt-preview-top"><span><MarketingIcon Name="calendar-days" Size="17" /> FROM YOUR RESTAURANT</span></div><div class="bt-news-preview"><strong>Live music. This Friday.</strong><p>A little company. A great evening.</p></div><div class="bt-share-labels"><span>Event details</span><span>Guest RSVP</span><span>Guest list</span></div></div>
        </article>
    </div>
    <a href="/book-a-demo" class="bt-one-link bt-feature-demo-link">Book a demo of your restaurant’s tools</a>
</section>
