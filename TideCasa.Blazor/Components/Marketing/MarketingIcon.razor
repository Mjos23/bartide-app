@namespace TideCasa.Blazor.Components.Marketing

<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@Class" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "arrow-up-right":
            <path d="M7 7h10v10M7 17 17 7" />
            break;
        case "trending-up":
            <path d="m22 7-8.5 8.5-5-5L2 17M16 7h6v6" />
            break;
        case "check":
            <path d="m20 6-11 11-5-5" />
            break;
        case "message-circle":
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
            break;
        case "calendar-days":
            <path d="M8 2v4M16 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" />
            <rect x="3" y="4" width="18" height="18" rx="2" />
            break;
        case "heart":
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
            break;
        case "share":
            <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
            <path d="m8.59 13.51 6.83 3.98m-.01-10.98-6.82 3.98" />
            break;
        case "truck":
            <path d="M10 17h4V5H2v12h3m10 0h2m-3-9h4l4 4v5h-3" />
            <circle cx="7.5" cy="17.5" r="2.5" /><circle cx="17.5" cy="17.5" r="2.5" />
            break;
        case "book-open":
            <path d="M12 7v14m0-14C9 4 5 4 2 5v15c3-1 7-1 10 1 3-2 7-2 10-1V5c-3-1-7-1-10 2Z" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "arrow-up-right";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string? Class { get; set; }
}
